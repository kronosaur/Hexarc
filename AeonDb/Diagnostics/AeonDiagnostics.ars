	{
		class:"correctness.api-contracts"
		name:"invalid requests fail cleanly"
		steps:(
			{ msg:"Aeon.getValue" payload:("diag_no_such_table" ("row1")) expectMsg:"Error.notFound" }
			{ msg:"Aeon.createTable" payload:({ name:"diag_bad_key_type" x:{ keyType:"unknown" } }) expectMsg:"Error.unableToComply" }
			{ msg:"Aeon.createTable" payload:({ name:"diag_primary_list" x:{ keyType:"list_utf8" } }) expectMsg:"Error.unableToComply" }
			{ msg:"Aeon.createTable" payload:({ name:"diag_bad_path" x:{ keyType:"utf8" } }) expectMsg:"OK" }
			{ msg:"Aeon.insert" payload:("diag_bad_path" ("a" "extra") { value:1 }) expectMsg:"Error.unableToComply" }
			{ msg:"Aeon.getRows" payload:(("diag_bad_path" "missingView") ("a") (10) ()) expectMsg:"Error.notFound" }
			{ msg:"Aeon.mutate" payload:("diag_bad_path" ("a") { value:1 } { value:"notAnOperation" }) expectMsg:"Error.unableToComply" }
			{ msg:"Aeon.getValue" payload:("diag_bad_path" ("a")) expectMsg:"Reply.data" expectPayloadNil:true }
		)
	}
