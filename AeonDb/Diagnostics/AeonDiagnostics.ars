			{ msg:"Aeon.createTable" payload:({ name:"diag_recovery_replay" x:{ keyType:"utf8" } }) expectMsg:"OK" }
			{ msg:"Aeon.insert" payload:("diag_recovery_replay" ("volatile") { value:"from-recovery-log" }) expectMsg:"OK" }
			{ msg:"Aeon.testCrashReopen" payload:() expectMsg:"OK" }
			{ msg:"Aeon.getValue" payload:("diag_recovery_replay" ("volatile")) expectMsg:"Reply.data" expectPayload:{ value:"from-recovery-log" } }
		)
	}
	{
		class:"resilience.recovery-log"
		name:"crash reopen ignores partial trailing recovery record"
		steps:(
			{ msg:"Aeon.createTable" payload:({ name:"diag_recovery_tail" x:{ keyType:"utf8" } }) expectMsg:"OK" }
			{ msg:"Aeon.insert" payload:("diag_recovery_tail" ("stable") { value:"complete-prefix" }) expectMsg:"OK" }
			{ msg:"Aeon.testCrashReopen" payload:{ table:"diag_recovery_tail" action:"appendRecoveryGarbage" bytes:9 } expectMsg:"OK" }
			{ msg:"Aeon.getValue" payload:("diag_recovery_tail" ("stable")) expectMsg:"Reply.data" expectPayload:{ value:"complete-prefix" } }
		)
	}
	{
		class:"performance.primary"
		name:"primary table baseline"
		steps:(
			{ msg:"Aeon.createTable" payload:({ name:"perf_primary" x:{ keyType:"utf8" } }) expectMsg:"OK" }
			{ perf:"insertRange" label:"primary insert 10000 rows x 128B" table:"perf_primary" count:10000 valueBytes:128 keyPrefix:"p" }
			{ perf:"getRange" label:"primary point read 10000 in-memory rows" table:"perf_primary" count:10000 keyPrefix:"p" }
			{ perf:"message" label:"flush primary 10000 rows" msg:"Aeon.flushDb" payload:() expectMsg:"OK" }
			{ perf:"getRange" label:"primary point read 10000 flushed rows" table:"perf_primary" count:10000 keyPrefix:"p" }
			{ perf:"scanRows" label:"primary scan 10000 flushed rows" table:"perf_primary" count:10000 expectResultCount:20000 }
			{ perf:"message" label:"reopen primary sample database" msg:"Aeon.testReopen" payload:() expectMsg:"OK" }
			{ perf:"getRange" label:"primary point read 10000 after reopen" table:"perf_primary" count:10000 keyPrefix:"p" }
		)
	}
	{
		class:"performance.secondary"
		name:"secondary view baseline"
		steps:(
			{ msg:"Aeon.createTable" payload:({ name:"perf_secondary" x:{ keyType:"utf8" } secondaryViews:({ name:"byGroup" x:{ keyType:"utf8" key:"group" } columns:("*" "primaryKey") }) }) expectMsg:"OK" }
			{ perf:"insertRange" label:"secondary insert 5000 rows x 64B" table:"perf_secondary" count:5000 valueBytes:64 keyPrefix:"s" }
			{ perf:"scanRows" label:"secondary scan group g000 in-memory x1000" table:"perf_secondary" view:"byGroup" key:("g000") limits:(100 1) options:("noKey") count:50 repeat:1000 expectResultCount:50 }
			{ perf:"message" label:"flush secondary 5000 rows" msg:"Aeon.flushDb" payload:() expectMsg:"OK" }
			{ perf:"scanRows" label:"secondary scan group g000 flushed x1000" table:"perf_secondary" view:"byGroup" key:("g000") limits:(100 1) options:("noKey") count:50 repeat:1000 expectResultCount:50 }
			{ perf:"message" label:"reopen secondary sample database" msg:"Aeon.testReopen" payload:() expectMsg:"OK" }
			{ perf:"scanRows" label:"secondary scan group g000 after reopen x1000" table:"perf_secondary" view:"byGroup" key:("g000") limits:(100 1) options:("noKey") count:50 repeat:1000 expectResultCount:50 }
		)
