			{ msg:"Aeon.insert" payload:("diag_reopen" ("persisted") { value:"after-reopen" }) expectMsg:"OK" }
			{ msg:"Aeon.testReopen" payload:() expectMsg:"OK" }
			{ msg:"Aeon.getValue" payload:("diag_reopen" ("persisted")) expectMsg:"Reply.data" expectPayload:{ value:"after-reopen" } }
		)
	}
