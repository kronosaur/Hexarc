diff --git a/core/iwasm/common/wasm_exec_env.h b/core/iwasm/common/wasm_exec_env.h
index 5d80312f..dced4b06 100644
--- a/core/iwasm/common/wasm_exec_env.h
+++ b/core/iwasm/common/wasm_exec_env.h
@@ -141,6 +141,13 @@ typedef struct WASMExecEnv {
 
     void *user_data;
 
+#if WASM_ENABLE_GRIDWHALE_YIELD != 0
+    void (*yield_callback)(struct WASMExecEnv *exec_env, void *user_data);
+    void *yield_callback_user_data;
+    uint32 yield_check_interval;
+    uint32 yield_check_countdown;
+#endif
+
     /* The boundary of native stack set by host embedder. It is used
        if it is not NULL when calling wasm functions. */
     uint8 *user_native_stack_boundary;
@@ -184,6 +191,23 @@ typedef struct WASMExecEnv {
 #define RECORD_STACK_USAGE(e, p) (void)0
 #endif
 
+#if WASM_ENABLE_GRIDWHALE_YIELD != 0
+static inline void
+wasm_exec_env_check_yield(WASMExecEnv *exec_env)
+{
+    if (exec_env->yield_callback && exec_env->yield_check_interval > 0) {
+        if (exec_env->yield_check_countdown == 0)
+            exec_env->yield_check_countdown = exec_env->yield_check_interval;
+
+        if (--exec_env->yield_check_countdown == 0)
+            exec_env->yield_callback(exec_env, exec_env->yield_callback_user_data);
+    }
+}
+#define CHECK_GRIDWHALE_YIELD(exec_env) wasm_exec_env_check_yield(exec_env)
+#else
+#define CHECK_GRIDWHALE_YIELD(exec_env) (void)0
+#endif
+
 WASMExecEnv *
 wasm_exec_env_create_internal(struct WASMModuleInstanceCommon *module_inst,
                               uint32 stack_size);
diff --git a/core/iwasm/common/wasm_runtime_common.c b/core/iwasm/common/wasm_runtime_common.c
index 6590684c..1e48050d 100644
--- a/core/iwasm/common/wasm_runtime_common.c
+++ b/core/iwasm/common/wasm_runtime_common.c
@@ -2455,6 +2455,35 @@ wasm_runtime_get_user_data(WASMExecEnv *exec_env)
     return exec_env->user_data;
 }
 
+void
+wasm_runtime_set_yield_callback(WASMExecEnv *exec_env,
+                                wasm_runtime_yield_callback_t callback,
+                                void *user_data)
+{
+#if WASM_ENABLE_GRIDWHALE_YIELD != 0
+    exec_env->yield_callback = callback;
+    exec_env->yield_callback_user_data = user_data;
+    exec_env->yield_check_countdown = exec_env->yield_check_interval;
+#else
+    (void)exec_env;
+    (void)callback;
+    (void)user_data;
+#endif
+}
+
+void
+wasm_runtime_set_yield_check_interval(WASMExecEnv *exec_env,
+                                      uint32 instruction_count)
+{
+#if WASM_ENABLE_GRIDWHALE_YIELD != 0
+    exec_env->yield_check_interval = instruction_count;
+    exec_env->yield_check_countdown = instruction_count;
+#else
+    (void)exec_env;
+    (void)instruction_count;
+#endif
+}
+
 void
 wasm_runtime_set_native_stack_boundary(WASMExecEnv *exec_env,
                                        uint8 *native_stack_boundary)
